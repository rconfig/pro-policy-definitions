// NIST-AC-2: AAA central authentication
#[match_code_block_flexible]
system {
 authentication-order [ radius tacplus password ];
}

// NIST-AC-17: SSH protocol version 2 configured
#[match_code_block_flexible]
system {
 services {
  ssh {
   protocol-version v2;
  }
 }
}

// NIST-AC-17: Telnet service absent
#[must_not_match_regex]
/^\s*system\s*{\s*services\s*{\s*telnet;\s*}\s*}/m

// NIST-IA-5: No plaintext passwords for users
#[must_not_match_regex]
/^\s*system\s*{\s*login\s*{\s*user\s+.+\s*{\s*authentication\s*{\s*plain-text-password\s*;\s*}\s*}\s*}\s*}/m

// NIST-AU-2/AU-12: Syslog remote + timestamps
#[match_code_block_flexible]
system {
 syslog {
  host * {
   any info;
   authorization info;
  }
  time-format millisecond;
 }
}

// NIST-CM-7: Disable unnecessary services
#[must_not_match_regex]
/^\s*system\s*{\s*services\s*{\s*(ftp|telnet|finger|rlogin|rsh|rexec);\s*}\s*}/m

// NIST-SC-12: No SNMP community configured
#[must_not_match_regex]
/^\s*snmp\s*{\s*community\s+.+;\s*}/m

// NIST-SC-12: SNMPv3 USM user uses SHA authentication and AES-128 privacy
#[match_code_block_flexible]
snmp {
 v3 {
  usm {
   local-engine user * {
    authentication-sha;
    privacy-aes128;
   }
  }
 }
}
