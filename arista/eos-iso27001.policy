// ISO 27001 A.5.17: No local user is configured without a password (fails on username ... nopassword)
#[must_not_match_regex]
/^username \S+ .*\bnopassword\b/m

// ISO 27001 A.8.2: The root account is not enabled (fails on an aaa root line)
#[must_not_match_regex]
/^aaa root /m

// ISO 27001 A.8.5: Login authentication uses a remote server group with local fallback (aaa authentication login default group ... local)
#[must_match_regex]
/^aaa authentication login default group \S+(?: \S+)* local$/m

// ISO 27001 A.8.5: Telnet is not enabled (fails on no shutdown under management telnet)
#[must_not_match_regex]
/^management telnet\n(?:[ \t]+.*\n)*?[ \t]+no shutdown$/m

// ISO 27001 A.8.5: The SSH idle timeout is 1 to 10 minutes (idle-timeout under management ssh)
#[evaluate_block]
scope: ^management ssh$
all:
  - regex: '/^\s+idle-timeout ([1-9]|10)$/m'

// ISO 27001 A.8.5: A login banner is configured (banner login)
#[must_match_regex]
/^banner login$/m

// ISO 27001 A.8.5: No SNMPv1 or SNMPv2c community is configured (fails on snmp-server community)
#[must_not_match_regex]
/^snmp-server community /m

// ISO 27001 A.8.5, A.8.24: An SNMPv3 group uses authPriv (snmp-server group ... v3 priv)
#[must_match_regex]
/^snmp-server group \S+ v3 priv\b/m

// ISO 27001 A.8.5, A.8.24: No SNMPv3 user uses MD5 authentication or DES privacy (fails on snmp-server user ... auth md5 or priv des)
#[must_not_match_regex]
/^snmp-server user \S+ \S+ .*\b(auth md5|priv (des|3des))\b/m

// ISO 27001 A.8.9: The eAPI does not serve plain HTTP (fails on protocol http under management api http-commands)
#[must_not_match_regex]
/^[ \t]+protocol http( port \d+)?$/m

// ISO 27001 A.8.15: All commands are sent to a remote accounting group (aaa accounting commands all default ... group)
#[must_match_regex]
/^aaa accounting commands all default (start-stop|stop-only) group /m

// ISO 27001 A.8.15: A remote syslog host is configured (logging host, in any VRF)
#[must_match_regex]
/^logging (vrf \S+ )?host \S+/m

// ISO 27001 A.8.15: Log timestamps use high resolution (logging format timestamp high-resolution)
#[must_match_regex]
/^logging format timestamp high-resolution\b/m

// ISO 27001 A.8.24: No SSH cipher or MAC line selects a CBC, 3DES, arcfour, blowfish, MD5 or SHA-1 algorithm (cipher, mac)
#[must_not_match_regex]
/^[ \t]+(cipher .*(cbc|3des|arcfour|blowfish)|mac .*\bhmac-(md5|sha1)\b)/m
