// HIPAA 164.312(a)(1): Login authentication uses a TACACS+ or RADIUS server group (aaa authentication login default group ...)
#[must_match_regex]
/^aaa authentication login default group \S+/m

// HIPAA 164.312(a)(1): SSH server is enabled for version 2 (ssh server v2)
#[must_match_single_string]
ssh server v2

// HIPAA 164.312(a)(1): The Telnet server is not enabled (fails on telnet ... ipv4 or ipv6 server max-servers)
#[must_not_match_regex]
/^telnet (vrf \S+ )?ipv[46] server max-servers/m

// HIPAA 164.312(a)(1): No transport input line permits Telnet (telnet or all)
#[must_not_match_regex]
/^\s*transport input .*\b(telnet|all)\b/m

// HIPAA 164.312(b): A remote syslog host is configured by address (logging <address>)
#[must_match_regex]
/^logging (\d{1,3}(\.\d{1,3}){3}|[0-9A-Fa-f]*:[0-9A-Fa-f:]+)( |$)/m

// HIPAA 164.312(b): Log timestamps include milliseconds (fails on service timestamps log without datetime msec)
#[must_not_match_regex]
/^service timestamps log (?!datetime\b.*\bmsec\b)/m

// HIPAA 164.312(b): Console logging is disabled or limited to critical and above (logging console disable, critical, alerts or emergencies)
#[must_match_regex]
/^logging console (disable|critical|alerts|emergencies)$/m

// HIPAA 164.312(c)(1): The TFTP server is not enabled (fails on tftp ipv4 or ipv6 server)
#[must_not_match_regex]
/^tftp (vrf \S+ )?ipv[46] server /m

// HIPAA 164.312(e)(1): No SNMPv1 or SNMPv2c community is configured (line snmp-server community is absent)
#[must_not_match_regex]
/^snmp-server community /m

// HIPAA 164.312(e)(1): Every SNMP user is v3 with SHA authentication and AES privacy, and none uses v1, v2c, MD5, DES or 3DES (snmp-server user)
#[evaluate_block]
all:
  - regex: '/^snmp-server user \S+ \S+ v3 auth sha\S* .*\bpriv aes /m'
  - not:
      regex: '/^snmp-server user \S+ \S+ (v1|v2c|remote)\b/m'
  - not:
      regex: '/^snmp-server user \S+ \S+ v3 auth md5\b/m'
  - not:
      regex: '/^snmp-server user \S+ \S+ v3 .*\bpriv (des56|3des)\b/m'
  - not:
      regex: '/^snmp-server user \S+ \S+ v3(?!.*\bpriv\b)/m'

// HIPAA 164.312(e)(1): An SNMPv3 group uses authPriv (snmp-server group ... v3 priv)
#[must_match_regex]
/^snmp-server group \S+ v3 priv\b/m
