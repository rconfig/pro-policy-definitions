// HIPAA-AC-1: AAA enabled
#[must_match_single_string]
aaa new-model

// HIPAA-AC-2: AAA login authentication on console line
#[match_code_block_from_array]
line con 0
 login authentication default

// HIPAA-AC-2: AAA login authentication on VTY lines 0-4
#[match_code_block_from_array]
line vty 0 4
 login authentication default

// HIPAA-AC-3: SSH version 2 enabled
#[must_match_single_string]
ip ssh version 2

// HIPAA-AC-3: Telnet disabled (no transport input telnet line)
#[must_not_match_single_string]
transport input telnet

// HIPAA-AU-1: Remote syslog configured
#[must_match_regex]
/^logging host \S+/m

// HIPAA-AU-2: Timestamping logs
#[must_match_single_string]
service timestamps log datetime msec

// HIPAA-AU-3: Console logging disabled
#[must_not_match_single_string]
logging console

// HIPAA-IN-1: Disable finger service
#[must_not_match_single_string]
service finger

// HIPAA-IN-1: Disable BOOTP server
#[must_not_match_single_string]
ip bootp server

// HIPAA-IN-1: Disable TCP small servers
#[must_not_match_single_string]
service tcp-small-servers

// HIPAA-TS-1: SNMPv3 must be enabled (authPriv)
#[must_match_regex]
/^snmp-server group .+ v3 priv/m

// HIPAA-TS-2: SNMPv1/v2 must not be used
#[must_not_match_regex]
/^snmp-server community /m
