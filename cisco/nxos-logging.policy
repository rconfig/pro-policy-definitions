// A remote syslog server is configured (logging server)
#[must_match_regex]
/^logging server \S+/m

// Log timestamps use milliseconds or microseconds (logging timestamp milliseconds)
#[must_match_regex]
/^logging timestamp (milliseconds|microseconds)$/m

// Console logging is not more verbose than critical (fails on logging console 3 to 7)
#[must_not_match_regex]
/^logging console [3-7]$/m
