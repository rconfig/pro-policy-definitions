// NTP servers are set to your standard (replace 192.0.2.10 and 192.0.2.11)
#[evaluate_block]
all:
  - regex: '/^ntp server 192\.0\.2\.10(?= |$)/m'
  - regex: '/^ntp server 192\.0\.2\.11(?= |$)/m'

// Syslog servers are set to your standard (replace 192.0.2.20 and 192.0.2.21)
#[evaluate_block]
all:
  - regex: '/^logging server 192\.0\.2\.20(?= |$)/m'
  - regex: '/^logging server 192\.0\.2\.21(?= |$)/m'

// A MOTD banner is set (banner motd, any text; nothing to replace)
#[must_match_regex]
/^banner motd \S/m

// The hostname follows your naming pattern (replace the example pattern [a-z]{3}-(rtr|sw)[0-9]{2}, for example dub-sw01)
#[must_match_regex]
/^hostname [a-z]{3}-(rtr|sw)[0-9]{2}$/m

// An SNMP location is set (snmp-server location, any text; nothing to replace)
#[must_match_regex]
/^snmp-server location \S/m
