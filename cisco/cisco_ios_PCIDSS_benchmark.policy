// PCI-2.1: Disable HTTP server
#[must_not_match_single_string]
ip http server

// PCI-2.1: Disable BOOTP server
#[must_not_match_single_string]
ip bootp server

// PCI-2.1: Disable finger service
#[must_not_match_single_string]
service finger

// PCI-2.2: AAA enabled
#[must_match_single_string]
aaa new-model

// PCI-6.1: SSH version 2 enabled
#[must_match_single_string]
ip ssh version 2

// PCI-6.1: Telnet disabled (no transport input line permits telnet or all)
#[must_not_match_regex]
/^\s*transport input .*\b(telnet|all)\b/m

// PCI-6.2: User accounts must not use plaintext passwords
#[must_not_match_regex]
/^username .* password 0 .+/m

// PCI-10.1: Syslog to remote server
#[must_match_regex]
/^logging host \S+/m

// PCI-10.2: Logging timestamps enabled
#[must_match_single_string]
service timestamps log datetime msec

// PCI-10.3: Console logging disabled (no logging console line at any level)
#[must_not_match_regex]
/^logging console\b/m
