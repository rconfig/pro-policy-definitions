// SAFE-IA-1: Enable AAA
#[must_match_single_string]
aaa new-model

// SAFE-IA-2: SSH version 2 enabled
#[must_match_single_string]
ip ssh version 2

// SAFE-IA-2: Telnet disabled (no transport input line permits telnet or all)
#[must_not_match_regex]
/^\s*transport input .*\b(telnet|all)\b/m

// SAFE-IA-3: VTY 0 4 exec-timeout set to 10 minutes (exec-timeout 10 0)
#[match_code_block_from_array]
line vty 0 4
 exec-timeout 10 0

// SAFE-VL-1: Enable syslog remote logging
#[must_match_regex]
/^logging host \S+/m

// SAFE-VL-2: Enable timestamped logging
#[must_match_single_string]
service timestamps log datetime msec

// SAFE-VL-3: Disable console logging (no logging console line at any level)
#[must_not_match_regex]
/^logging console\b/m

// SAFE-TD-1: Disable HTTP server
#[must_not_match_single_string]
ip http server

// SAFE-TD-1: Disable HTTPS server
#[must_not_match_single_string]
ip http secure-server

// SAFE-TD-2: Disable finger service
#[must_not_match_single_string]
service finger

// SAFE-TD-2: Disable BOOTP server
#[must_not_match_single_string]
ip bootp server

// SAFE-TD-3: Disable source routing
#[must_not_match_single_string]
ip source-route
