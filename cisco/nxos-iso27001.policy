// ISO 27001 A.5.17: Password strength checking is not disabled (fails on no password strength-check)
#[must_not_match_regex]
/^no password strength-check$/m

// ISO 27001 A.5.17: AES password encryption is enabled for stored keys (feature password encryption aes)
#[must_match_single_string]
feature password encryption aes

// ISO 27001 A.8.5: Login authentication uses a TACACS+ or RADIUS server group (aaa authentication login default group ...)
#[must_match_regex]
/^aaa authentication login default group \S+/m

// ISO 27001 A.8.5: Telnet is not enabled (fails on feature telnet)
#[must_not_match_regex]
/^feature telnet$/m

// ISO 27001 A.8.5: The VTY line sets an exec-timeout of 1 to 10 minutes (line vty, exec-timeout)
#[evaluate_block]
scope: ^line vty$
all:
  - regex: '/^\s+exec-timeout ([1-9]|10)$/m'

// ISO 27001 A.8.5: The console line sets an exec-timeout of 1 to 10 minutes (line console, exec-timeout)
#[evaluate_block]
scope: ^line console$
all:
  - regex: '/^\s+exec-timeout ([1-9]|10)$/m'

// ISO 27001 A.8.5: A MOTD banner is configured (banner motd)
#[must_match_regex]
/^banner motd \S/m

// ISO 27001 A.8.5: No SNMPv1 or SNMPv2c community is configured (line snmp-server community is absent)
#[must_not_match_regex]
/^snmp-server community /m

// ISO 27001 A.8.5, A.8.24: No SNMP user uses MD5 authentication (fails on snmp-server user ... auth md5)
#[must_not_match_regex]
/^snmp-server user \S+ .*\bauth md5\b/m

// ISO 27001 A.8.5, A.8.24: SNMP message encryption is enforced for all users (snmp-server globalEnforcePriv)
#[must_match_single_string]
snmp-server globalEnforcePriv

// ISO 27001 A.8.9: CDP is disabled globally (no cdp enable)
#[must_match_regex]
/^no cdp enable$/m

// ISO 27001 A.8.15: AAA accounting sends to a server group (aaa accounting default group ...)
#[must_match_regex]
/^aaa accounting default group \S+/m

// ISO 27001 A.8.15: A remote syslog server is configured (logging server)
#[must_match_regex]
/^logging server \S+/m

// ISO 27001 A.8.15: Log timestamps use milliseconds or microseconds (logging timestamp milliseconds)
#[must_match_regex]
/^logging timestamp (milliseconds|microseconds)$/m

// ISO 27001 A.8.20: Proxy ARP is not enabled on any interface (fails on ip proxy-arp)
#[must_not_match_regex]
/^\s+ip proxy[- ]arp$/m

// ISO 27001 A.8.20: Directed broadcast is not enabled on any interface (fails on ip directed-broadcast)
#[must_not_match_regex]
/^\s+ip directed-broadcast\b/m

// ISO 27001 A.8.24: SSH is not disabled (fails on no feature ssh)
#[must_not_match_regex]
/^no feature ssh$/m
