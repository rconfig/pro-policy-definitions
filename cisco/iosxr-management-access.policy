// SSH server is enabled for version 2 (ssh server v2)
#[must_match_single_string]
ssh server v2

// The Telnet server is not enabled (fails on telnet ... ipv4 or ipv6 server max-servers)
#[must_not_match_regex]
/^telnet (vrf \S+ )?ipv[46] server max-servers/m

// No transport input line permits Telnet (telnet or all)
#[must_not_match_regex]
/^\s*transport input .*\b(telnet|all)\b/m

// No line sets an exec-timeout outside 1 to 10 minutes (no line means the 10 0 default)
#[must_not_match_regex]
/^\s+exec-timeout (?!(?:[1-9](?: [1-5]?[0-9])?|10(?: 0)?)\s*$)/m

// A MOTD or login banner is configured (banner motd or banner login)
#[must_match_regex]
/^banner (motd|login) \S/m
