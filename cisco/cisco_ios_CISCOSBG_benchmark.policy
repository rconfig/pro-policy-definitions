// SBG-MP-1: AAA enabled
#[must_match_single_string]
aaa new-model

// SBG-MP-2: SSH version 2 enabled
#[must_match_single_string]
ip ssh version 2

// SBG-MP-2: Telnet disabled (no transport input line permits telnet or all)
#[must_not_match_regex]
/^\s*transport input .*\b(telnet|all)\b/m

// SBG-MP-3: Banner MOTD set
#[must_match_regex]
/^banner motd .+/m

// SBG-LOG-1: Remote syslog configured
#[must_match_regex]
/^logging host \S+/m

// SBG-LOG-2: Timestamps enabled
#[must_match_single_string]
service timestamps log datetime msec

// SBG-IS-1: Disable HTTP server if not used
#[must_not_match_single_string]
ip http server

// SBG-IS-1: Disable HTTPS server if not used
#[must_not_match_single_string]
ip http secure-server

// SBG-IS-2: Disable finger service
#[must_not_match_single_string]
service finger

// SBG-IS-2: Disable TCP small servers
#[must_not_match_single_string]
service tcp-small-servers

// SBG-IS-2: Disable UDP small servers
#[must_not_match_single_string]
service udp-small-servers
