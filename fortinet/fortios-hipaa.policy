// HIPAA 164.312(a)(1): The admin idle timeout is 10 minutes (set admintimeout 10)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set admintimeout 10

// HIPAA 164.312(a)(1): Strong crypto is enabled (set strong-crypto enable)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set strong-crypto enable

// HIPAA 164.312(b): Remote syslog is enabled with a server on UDP port 514 (config log syslogd setting)
#[evaluate_block]
scope: ^config log syslogd setting$
all:
  - equals: set status enable
  - regex: '/^\s*set server "?[^"\s]/m'
  - equals: set port 514
  - equals: set mode udp

// HIPAA 164.312(b): The syslog filter severity is information or notice (config log syslogd filter)
#[evaluate_block]
scope: ^config log syslogd filter$
any:
  - equals: set severity information
  - equals: set severity notice

// HIPAA 164.312(c)(1): No interface allowaccess line permits telnet, http, rsh or rexec
#[must_not_match_regex]
/^\s*set\s+allowaccess\s+.*\b(telnet|http|rsh|rexec)\b.*$/m

// HIPAA 164.312(e)(1): No SNMPv1 or SNMPv2c community is configured (config system snmp community is absent)
#[must_not_match_regex]
/^\s*config\s+system\s+snmp\s+community\b/m

// HIPAA 164.312(e)(1): Every SNMPv3 user uses SHA authentication and AES privacy
#[evaluate_block]
scope: ^config system snmp user$
all:
  - regex: '/^\s*set auth-proto sha/m'
  - regex: '/^\s*set priv-proto aes/m'
  - not:
      regex: '/^\s*set auth-proto (?!sha)/m'
  - not:
      regex: '/^\s*set priv-proto (?!aes)/m'
