// NIST CSF DE.CM-1: Remote syslog is enabled with a server on UDP port 514 (config log syslogd setting)
#[evaluate_block]
scope: ^config log syslogd setting$
all:
  - equals: set status enable
  - regex: '/^\s*set server "?[^"\s]/m'
  - equals: set port 514
  - equals: set mode udp

// NIST CSF PR.AC-1: Strong crypto is enabled (set strong-crypto enable)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set strong-crypto enable
