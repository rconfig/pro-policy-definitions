// PCI-2.2: Secure configurations — HTTPS/SSH only
#[match_code_block_from_array]
config system global
 set admin-http disable
 set admin-https enable
 set strong-crypto enable
end

// PCI-6.x: Admin idle timeout set to 10 minutes (set admintimeout 10)
#[match_code_block_from_array]
config system global
 set admintimeout 10
end

// PCI-7.x: Central authentication (RADIUS) present
#[match_code_block_from_array]
config user radius
 edit *
  set server *
 next
end

// PCI-10.x: Remote syslog enabled with a server on UDP port 514
#[match_code_block_from_array]
config log syslogd setting
 set status enable
 set server *
 set port 514
 set mode udp
end

// PCI-10.x: Syslog severity filter set to notice
#[match_code_block_from_array]
config log syslogd filter
 set severity notice
end

// PCI-4.1: Encrypt management traffic; disallow Telnet/HTTP on interfaces
#[must_not_match_regex]
/^\s*set\s+allowaccess\s+.*\b(telnet|http)\b.*$/m

// PCI-3.x: No SNMP v1/v2c community configured
#[must_not_match_regex]
/^\s*config\s+system\s+snmp\s+community\b/m

// PCI-3.x: SNMPv3 user uses SHA authentication and AES privacy
#[match_code_block_from_array]
config system snmp user
 edit *
  set auth-proto sha
  set priv-proto aes
 next
end
