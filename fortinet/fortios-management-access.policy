// The admin idle timeout is 10 minutes (set admintimeout 10)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set admintimeout 10

// No interface allowaccess line permits telnet, http, rsh or rexec
#[must_not_match_regex]
/^\s*set\s+allowaccess\s+.*\b(telnet|http|rsh|rexec)\b.*$/m

// Strong crypto is enabled (set strong-crypto enable)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set strong-crypto enable

// The pre-login banner is enabled (set pre-login-banner enable)
#[evaluate_block]
scope: ^config system global$
all:
  - equals: set pre-login-banner enable
