// NTP servers are set to your standard (replace 192.0.2.10 and 192.0.2.11)
#[evaluate_block]
all:
  - regex: '/(^|[{;])\s*ntp-server-address 192\.0\.2\.10;/m'
  - regex: '/(^|[{;])\s*ntp-server-address 192\.0\.2\.11;/m'

// Syslog servers are set to your standard (replace 192.0.2.20 and 192.0.2.21)
#[evaluate_block]
scope: ^syslog \{
all:
  - regex: '/(^|[{;])\s*server 192\.0\.2\.20;/m'
  - regex: '/(^|[{;])\s*server 192\.0\.2\.21;/m'

// DNS servers are set to your standard (replace 192.0.2.30 and 192.0.2.31)
#[evaluate_block]
scope: ^dns-setting \{
all:
  - regex: '/(^|[{;])\s*primary 192\.0\.2\.30;/m'
  - regex: '/(^|[{;])\s*secondary 192\.0\.2\.31;/m'

// A login banner is set (login-banner, any text; nothing to replace)
#[must_match_regex]
/(^|[{;])\s*login-banner \S/m

// Every ethernet interface has a comment or is set to link-state down (nothing to replace)
#[evaluate_block]
scope: ^ethernet\d+/\d+ \{
any:
  - regex: '/\bcomment "?[^"\s;]/m'
  - regex: '/\blink-state down;/m'

// The hostname follows your naming pattern (replace the example pattern [a-z]{3}-fw[0-9]{2}, for example dub-fw01)
#[evaluate_block]
scope: ^deviceconfig \{$
all:
  - regex: '/(^|[{;])\s*hostname [a-z]{3}-fw[0-9]{2};/m'

// An SNMP location is set (snmp-setting snmp-system location, any text; nothing to replace)
#[evaluate_block]
scope: ^snmp-system \{
all:
  - regex: '/(^|[{;])\s*location \S/m'
